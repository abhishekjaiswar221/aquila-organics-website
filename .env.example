# Placeholders only. Never commit real secrets. Copy to .env for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (docker compose: `npm run db:up`)
DATABASE_URL="postgresql://aquila:aquila_dev_password@localhost:5432/aquila"
# Integration tests run against this database instead
DATABASE_URL_TEST="postgresql://aquila:aquila_dev_password@localhost:5432/aquila_test"

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Drivers
STORAGE_DRIVER=local
# Optional: local storage root (default ./storage/uploads; e2e uses ./storage/e2e/uploads)
# STORAGE_LOCAL_ROOT=./storage/uploads
EMAIL_DRIVER=dev

# Salt for hashing rate-limit identifiers
RATE_LIMIT_SALT="replace-with-random-string"

# Optional: client IP for login rate limiting (see README "Deployment: reverse proxy and client IP")
# AUTH_IP_HEADER=x-forwarded-for
# AUTH_TRUSTED_PROXIES=10.0.0.1,192.0.2.0/24

# Optional: first admin seed (`npm run seed:admin`; password at least 12 characters)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-long-passphrase
