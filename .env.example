# Placeholders only. Never commit real secrets. Copy to .env for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (docker compose: `npm run db:up`)
DATABASE_URL="postgresql://aquila:aquila_dev_password@localhost:5432/aquila"
# Integration tests run against this database instead
DATABASE_URL_TEST="postgresql://aquila:aquila_dev_password@localhost:5432/aquila_test"

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Drivers
STORAGE_DRIVER=local
EMAIL_DRIVER=dev

# Salt for hashing rate-limit identifiers
RATE_LIMIT_SALT="replace-with-random-string"

# Optional: first admin seed
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
